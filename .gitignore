# ============================================================
# CUMBERLAND MOTOR INN — BACKEND (.gitignore)
# ============================================================

# ---- Dependencies ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Environment & secrets (NEVER commit these)
.env
.env.local
.env.*.local

# ---- Runtime logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Editors / IDEs (per-user IDE state)
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Node debugger profiler output ----
*.pem
*.key

# ---- Test coverage ----
coverage/
.nyc_output/

# ---- Build output (if we ever add a build step)
dist/
build/
out/

# ---- Misc OS generated during development ----
nodemon-debug.log

# ---- User-uploaded files ----
# Never commit photos/documents uploaded by the admin.
# Keep the folder itself with the .gitkeep placeholder so
# Express static + multer diskStorage work on fresh clones.
uploads/*
!uploads/.gitkeep
